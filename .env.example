# Copy this file to .env and fill in real values. Never commit the real .env.

ENV=development
SECRET_KEY=change-me-to-a-long-random-string
BACKEND_CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# --- Database (set automatically by docker-compose for local dev; override for managed Postgres in prod) ---
DATABASE_URL=postgresql+asyncpg://aiflow:aiflow@localhost:5432/aiflow
SYNC_DATABASE_URL=postgresql+psycopg2://aiflow:aiflow@localhost:5432/aiflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120

# --- Object storage: MinIO locally, real AWS S3 in production ---
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=aiflow_minio
S3_SECRET_ACCESS_KEY=aiflow_minio_secret
S3_BUCKET=aiflow-documents
S3_USE_PATH_STYLE=true
# In production (AWS S3): set S3_ENDPOINT_URL to your region endpoint (or omit
# for boto3's default), use real IAM credentials, and set S3_USE_PATH_STYLE=false.

# --- AI providers — server-side only. NEVER put these in frontend code. ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_CHAT_PROVIDER=anthropic
DEFAULT_CHAT_MODEL=claude-sonnet-4-6
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Stripe billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# --- Outbound email (leave SMTP_HOST blank in dev — emails will be logged instead of sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@aiflow.io
