ENV=production
SECRET_KEY=aiflow-prod-k8x2m9p4q7w1e5r3t6y8u0i2o4a7s5d8f2g6h9j3k1l0z
BACKEND_CORS_ORIGINS=https://ai-flow-frontend.vercel.app,http://localhost:5173
PUBLIC_BASE_URL=https://ai-flow-backend.onrender.com

# Database (Render PostgreSQL)
DATABASE_URL=postgresql+asyncpg://aiflow:aiflow@localhost:5432/aiflow
SYNC_DATABASE_URL=postgresql+psycopg2://aiflow:aiflow@localhost:5432/aiflow
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_MINUTES=30

# Rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120

# S3 (Cloudflare R2 or AWS S3)
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=aiflow-documents
S3_USE_PATH_STYLE=false

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=
DEFAULT_CHAT_PROVIDER=openai
DEFAULT_CHAT_MODEL=gpt-4o
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# Email (leave blank to log emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@aiflow.io
